# ---- OddsPapi (v5 / B2B trial) ----
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://v5.oddspapi.io
ODDSPAPI_LANG=en
ODDSPAPI_WS_URL=wss://v5.oddspapi.io/ws
ODDSPAPI_WS_ENABLED=true
# WebSocket channels to subscribe to (comma separated)
ODDSPAPI_WS_CHANNELS=fixtures,scores,odds
# Prediction-market exchanges we care about (OddsPapi bookmaker slugs)
EXCHANGES=kalshi,polymarket,polymarket.us,prophetx,limitless-ex
# OddsPapi sport ids to sync (10=Soccer, 11=Basketball, 14=American Football).
# Cricket id: run scripts/test_apis.py - it prints the id found via GET /sports.
SPORT_IDS=10,11,14

# ---- SportsDataIO ----
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io
# Free trial soccer only covers UEFA Champions League (competition 3)
SPORTSDATAIO_SOCCER_COMPETITION=3

# ---- Backend ----
DATABASE_URL=sqlite+aiosqlite:///./sportdata.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sportdata
BACKGROUND_JOBS_ENABLED=true
FIXTURE_SYNC_INTERVAL_SEC=600
ACTIVATION_INTERVAL_SEC=300
ACTIVATION_WINDOW_HOURS=24
SYNC_HORIZON_DAYS=3
